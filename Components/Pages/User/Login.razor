@page "/login"
@using TiendaVirtual.Service
@using TiendaVirtual.Provider
@using Blazored.LocalStorage
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthService authService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ILocalStorageService localStorage
@inject UserContextService UserContext
@inject ButtonViewService ButtonView
@inject AuthenticationStateProvider AuthProvider

<MudLayout>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Small" Class="my-8">
            <!-- Tarjeta de login -->
            <MudPaper Elevation="25" Class="pa-8 rounded-xl">
                <div class="text-center mb-6">
                    <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
                    <MudText Typo="Typo.h4" Class="mb-2" Color="Color.Primary">Iniciar Sesión</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Ingresa tus credenciales para acceder</MudText>
                </div>

                <!-- Campos de formulario -->
                <MudForm @ref="form" ValidationDelay="800">
                    <MudTextField T="string" Label="Usuario o Correo" @bind-Value="userInput" Required="true"
                        Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Person"
                        Variant="Variant.Outlined" Class="mb-4" />

                    <MudTextField T="string" Label="Contraseña" @bind-Value="passwordInput"
                        InputType="@ButtonView.InputType" Required="true" Adornment="Adornment.End"
                        AdornmentIcon="@ButtonView.Icon" OnAdornmentClick="ButtonView.Toggle"
                        AdornmentAriaLabel="Mostrar contraseña" Variant="Variant.Outlined" Class="mb-4">
                    </MudTextField>

                    <!-- Botón de login -->
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="HandleLogin" FullWidth="true"
                        Size="Size.Large" EndIcon="@Icons.Material.Filled.Login" Class="mb-4 mt-2 rounded-pill"
                        Disabled="@(form.IsValid || isLoading)">
                        
                            <MudProgressCircular Size="Size.Small" Color="Color.Primary" Class="mr-2" />
                        
                        Entrar
                    </MudButton>

                    <!-- Enlaces adicionales -->
                    <div class="d-flex justify-space-between mt-4">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            ¿No tienes cuenta?
                            <MudLink Href="/register" Color="Color.Primary" Underline="Underline.Hover">
                                Regístrate
                            </MudLink>
                        </MudText>

                        <MudLink Href="/recuperar-password" Color="Color.Secondary" Underline="Underline.Hover"
                            Typo="Typo.body2">
                            <MudIcon Icon="@Icons.Material.Filled.LockReset" Size="Size.Small" Class="mr-1" />
                            ¿Olvidaste tu contraseña?
                        </MudLink>
                    </div>
                </MudForm>
            </MudPaper>

            <!-- Separador decorativo -->
            <div class="text-center mt-8">
                <MudDivider Class="mb-4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">O continúa con</MudText>
                </MudDivider>

                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Store"
                    OnClick="@(() => Navigation.NavigateTo("/productos"))">
                    Explorar como invitado
                </MudButton>
            </div>
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private string userInput = string.Empty;
    private string passwordInput = string.Empty;
    private bool isRepart = false;
    private bool isLoading = false;
    private MudForm form;

    private async Task HandleLogin()
    {
        isLoading = true;
        StateHasChanged();

        await form.Validate();
        if (!form.IsValid)
        {
            Snackbar.Add("Debe de llenar todos los campos", Severity.Error);
            return;
        }

        StateHasChanged();

        try
        {
            Console.WriteLine("Login: Iniciando proceso de login");

            var token = await authService.LoginAsync(userInput, passwordInput);
            if (!string.IsNullOrEmpty(token))
            {
                Console.WriteLine("Login: Token obtenido, guardando en localStorage");

                // Guardar token
                await localStorage.SetItemAsync("authToken", token);

                // Asegurarnos de que se guardó
                await Task.Delay(50);

                if (AuthProvider is CustomAuthStateProvider customProvider)
                {
                    Console.WriteLine("Login: Notificando autenticación al CustomAuthStateProvider");

                    // 1. Notificar al CustomAuthStateProvider
                    await customProvider.NotifyUserAuthenticationAsync();

                    // Pequeña espera para asegurar propagación
                    await Task.Delay(100);
                }

                // 2. Invalidar cache de UserContextService
                Console.WriteLine("Login: Invalidando cache de UserContextService");
                UserContext.InvalidateCache();

                // 3. Notificar cambio de estado
                Console.WriteLine("Login: Notificando cambio de estado");
                UserContext.NotifyStateChanged();

                // 4. Esperar un poco más para asegurar que todo se actualice
                await Task.Delay(200);

                // 5. Verificar rol y redirigir
                isRepart = await UserContext.IsReparAsync();
                Console.WriteLine($"Login: ¿Es repartidor? {isRepart}");

                if (isRepart)
                {
                    Navigation.NavigateTo("/entregas", true);
                }
                else
                {
                    Snackbar.Add("¡Bienvenido!", Severity.Success);
                    Navigation.NavigateTo("/productos", true);
                }
            }
            else
            {
                Snackbar.Add("Credenciales incorrectas", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }

        StateHasChanged();
    }
}