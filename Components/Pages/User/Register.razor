@page "/register"
@using MudBlazor.Components
@using System.Text.RegularExpressions
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Authorization
@using TiendaVirtual.Service
@inject AuthService authService
@inject ISnackbar Snackbar
@inject ButtonViewService ButtonView
@inject NavigationManager Navigation

<MudLayout>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Small" Class="my-8">
            <!-- Tarjeta de registro -->
            <MudPaper Elevation="25" Class="pa-8 rounded-xl">
                <div class="text-center mb-6">
                    <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Large" Color="Color.Primary"
                        Class="mb-2" />
                    <MudText Typo="Typo.h4" Class="mb-2" Color="Color.Primary">Crear Cuenta</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Dark">Regístrate para comenzar a comprar</MudText>
                </div>

                <!-- Campos de formulario -->
                <MudForm @ref="form" ValidationDelay="800">
                    <!-- Username -->
                    <MudTextField T="string" Label="Nombre de usuario" @bind-Value="username" Required="true"
                        Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Person"
                        Variant="Variant.Outlined" Class="mb-4" HelperText="Mínimo 3 caracteres" />

                    <!-- Email -->
                    <MudTextField T="string" Label="Correo electrónico" @bind-Value="email" Required="true"
                        Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Email"
                        Variant="Variant.Outlined" Class="mb-4"
                        Validation="@(new EmailAddressAttribute() { ErrorMessage = "Por favor ingresa un email válido" })" />

                    <!-- Password -->
                    <MudTextField T="string" Label="Contraseña" @bind-Value="password" InputType="@ButtonView.InputType"
                        Required="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Lock"
                        Variant="Variant.Outlined" Class="mb-4"
                        HelperText="Mínimo 8 caracteres, con mayúsculas, minúsculas y números"
                        Validation="@(new Func<string, IEnumerable<string>>(PasswordStrength))">
                        <AdornmentEnd>
                            <MudIconButton Icon="@ButtonView.Icon" OnClick="ButtonView.Toggle" />
                        </AdornmentEnd>
                    </MudTextField>

                    <!-- Confirm Password -->
                    <MudTextField T="string" Label="Confirmar contraseña" @bind-Value="repeatPassword"
                       InputType="@ButtonView.InputType" Required="true" Adornment="Adornment.End"
                        AdornmentIcon="@ButtonView.Icon" OnAdornmentClick="ButtonView.Toggle"
                        AdornmentAriaLabel="Mostrar contraseña" Variant="Variant.Outlined" Class="mb-4"
                        Validation="PasswordMatch">
                        <AdornmentEnd>
                            <MudIconButton Icon="@ButtonView.Icon" OnClick="ButtonView.Toggle" />
                        </AdornmentEnd>
                    </MudTextField>

                    <!-- Botón de registro -->
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="HandleRegister" FullWidth="true"
                        Size="Size.Large" EndIcon="@Icons.Material.Filled.HowToReg" Class="mb-4 mt-2 rounded-pill"
                        Disabled="@(form.IsValid || isLoading)">
                        @if (isLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Color="Color.Primary" Class="mr-2" />
                        }
                        Crear Cuenta
                    </MudButton>

                    <!-- Enlace para login -->
                    <div class="text-center mt-4">
                        <MudText Typo="Typo.body2">
                            ¿Ya tienes una cuenta?
                            <MudLink Href="/login" Color="Color.Primary" Underline="Underline.Hover">
                                Inicia sesión
                            </MudLink>
                        </MudText>
                    </div>
                </MudForm>
            </MudPaper>

            <!-- Beneficios -->
            <MudPaper Class="pa-4 mt-6 text-center" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-3" Color="Color.Primary">Beneficios de registrarse</MudText>
                <MudGrid>
                    <MudGridItem Xs="6" Sm="3">
                        <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Color="Color.Success" Class="mb-1" />
                        <MudText Typo="Typo.caption">Historial de compras</MudText>
                    </MudGridItem>
                    <MudGridItem Xs="6" Sm="3">
                        <MudIcon Icon="@Icons.Material.Filled.RocketLaunch" Color="Color.Success" Class="mb-1" />
                        <MudText Typo="Typo.caption">Envíos más rápidos</MudText>
                    </MudGridItem>
                    <MudGridItem Xs="6" Sm="3">
                        <MudIcon Icon="@Icons.Material.Filled.Security" Color="Color.Success" Class="mb-1" />
                        <MudText Typo="Typo.caption">Compra segura</MudText>
                    </MudGridItem>
                </MudGrid>
            </MudPaper>
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private string username = string.Empty;
    private string email = string.Empty;
    private string password = string.Empty;
    private string repeatPassword = string.Empty;
    private bool isLoading = false;
    private MudForm? form;

    private IEnumerable<string> PasswordStrength(string pw)
    {
        if (string.IsNullOrWhiteSpace(pw))
        {
            yield return "La contraseña es requerida";
            yield break;
        }

        var errors = new List<string>();
        if (pw.Length < 8) errors.Add("Debe tener al menos 8 caracteres");
        if (!Regex.IsMatch(pw, @"[A-Z]")) errors.Add("Debe tener una letra mayúscula");
        if (!Regex.IsMatch(pw, @"[a-z]")) errors.Add("Debe tener una letra minúscula");
        if (!Regex.IsMatch(pw, @"[0-9]")) errors.Add("Debe tener un número");
        if (!Regex.IsMatch(pw, @"[!@#$%^&*]")) errors.Add("Debe tener un carácter especial (!@#$%^&*)");

        foreach (var error in errors) yield return error;
    }

    private string PasswordMatch(string arg)
    {
        if (string.IsNullOrWhiteSpace(arg)) return "Por favor confirma tu contraseña";
        if (password != arg) return "Las contraseñas no coinciden";
        return null;
    }

    private int GetPasswordStrengthScore()
    {
        if (string.IsNullOrEmpty(password)) return 0;

        int score = 0;
        if (password.Length >= 8) score += 20;
        if (Regex.IsMatch(password, @"[A-Z]")) score += 20;
        if (Regex.IsMatch(password, @"[a-z]")) score += 20;
        if (Regex.IsMatch(password, @"[0-9]")) score += 20;
        if (Regex.IsMatch(password, @"[!@#$%^&*]")) score += 20;

        return score;
    }



    private async Task HandleRegister()
    {
        if (!form.IsValid)
        {
            Snackbar.Add("Credenciales incorrectas", Severity.Error);
            return;
        }

        isLoading = true;
        StateHasChanged();

        try
        {
            var success = await authService.RegisterAsync(username, email, password);
            if (success)
            {
                Snackbar.Add("¡Registro exitoso! Por favor inicia sesión", Severity.Success);
                await Task.Delay(1500);
                Navigation.NavigateTo("/login");
            }
            else
            {
                Snackbar.Add("El usuario o correo ya existe", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al registrar: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }
}