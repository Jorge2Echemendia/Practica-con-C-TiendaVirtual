@page "/recuperar-password"
@using System.Text.RegularExpressions
@using System.ComponentModel.DataAnnotations
@using TiendaVirtual.Service
@inject AuthService authService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject ButtonViewService ButtonView

<MudLayout>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Small" Class="my-8">
            <!-- Tarjeta de recuperación -->
            <MudPaper Elevation="25" Class="pa-8 rounded-xl">
                <div class="text-center mb-6">
                    <MudIcon Icon="@Icons.Material.Filled.LockReset" Size="Size.Large" Color="Color.Primary"
                        Class="mb-2" />
                    <MudText Typo="Typo.h4" Class="mb-2" Color="Color.Primary">Recuperar Contraseña</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Dark">
                        Ingresa tu correo y nueva contraseña para restablecer tu acceso
                    </MudText>
                </div>

                <!-- Formulario -->
                <MudForm @ref="form" ValidationDelay="800">
                    <!-- Email -->
                    <MudTextField T="string" Label="Correo electrónico" @bind-Value="email" Required="true"
                        Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Email"
                        Variant="Variant.Outlined" Class="mb-4"
                        Validation="@(new EmailAddressAttribute() { ErrorMessage = "Por favor ingresa un email válido" })" />

                    <!-- Nueva contraseña -->
                    <MudTextField T="string" Label="Nueva contraseña" @bind-Value="newPassword"
                        InputType="@ButtonView.InputType" Required="true" Adornment="Adornment.Start"
                        AdornmentIcon="@Icons.Material.Filled.Lock" Variant="Variant.Outlined" Class="mb-4"
                        HelperText="Mínimo 8 caracteres, con mayúsculas, minúsculas y números"
                        Validation="@(new Func<string, IEnumerable<string>>(PasswordStrength))">
                        <AdornmentEnd>
                            <MudIconButton Icon="@ButtonView.Icon" OnClick="ButtonView.Toggle" />
                        </AdornmentEnd>
                    </MudTextField>

                    <!-- Confirmar contraseña -->
                    <MudTextField T="string" Label="Confirmar nueva contraseña" @bind-Value="confirmPassword"
                        InputType="@ButtonView.InputType" Required="true" Adornment="Adornment.End"
                        AdornmentIcon="@ButtonView.Icon" OnAdornmentClick="ButtonView.Toggle"
                        AdornmentAriaLabel="Mostrar contraseña" Variant="Variant.Outlined" Class="mb-4"
                        Validation="PasswordMatch">
                        <AdornmentEnd>
                            <MudIconButton Icon="@ButtonView.Icon" OnClick="ButtonView.Toggle" />
                        </AdornmentEnd>
                    </MudTextField>

                    <!-- Botón de recuperación -->
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="HandleReset" FullWidth="true"
                        Size="Size.Large" EndIcon="@Icons.Material.Filled.Verified" Class="mb-4 mt-2 rounded-pill"
                        Disabled="@(isLoading || !form.IsValid )">

                        <MudProgressCircular Size="Size.Small" Color="Color.Primary" Class="mr-2" />

                        Restablecer Contraseña
                    </MudButton>

                    <!-- Enlaces adicionales -->
                    <div class="text-center mt-4">
                        <MudText Typo="Typo.body2" Class="mb-2">
                            ¿Recordaste tu contraseña?
                            <MudLink Href="/login" Color="Color.Primary" Underline="Underline.Hover">
                                Inicia sesión
                            </MudLink>
                        </MudText>

                        <MudText Typo="Typo.body2">
                            ¿No tienes cuenta?
                            <MudLink Href="/register" Color="Color.Primary" Underline="Underline.Hover">
                                Regístrate
                            </MudLink>
                        </MudText>
                    </div>
                </MudForm>
            </MudPaper>

            <!-- Información de seguridad -->
            <MudPaper Class="pa-4 mt-6" Elevation="1">
                <div class="d-flex align-center mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.Security" Color="Color.Info" Class="mr-2" />
                    <MudText Typo="Typo.subtitle1">Consejos de seguridad</MudText>
                </div>
                <MudList T="string" Dense="true">
                    <MudListItem>
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success"
                            Class="mr-2" />
                        <MudText Typo="Typo.body2">Usa una contraseña única que no utilices en otros sitios</MudText>
                    </MudListItem>
                    <MudListItem>
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success"
                            Class="mr-2" />
                        <MudText Typo="Typo.body2">Combina letras, números y caracteres especiales</MudText>
                    </MudListItem>
                    <MudListItem>
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success"
                            Class="mr-2" />
                        <MudText Typo="Typo.body2">Evita información personal como fechas de nacimiento</MudText>
                    </MudListItem>
                </MudList>
            </MudPaper>
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private string email = string.Empty;
    private string newPassword = string.Empty;
    private string confirmPassword = string.Empty;
    private bool isLoading = false;
    private MudForm form;

    private IEnumerable<string> PasswordStrength(string pw)
    {
        if (string.IsNullOrWhiteSpace(pw))
        {
            yield return "La contraseña es requerida";
            yield break;
        }

        if (pw.Length < 8) yield return "Debe tener al menos 8 caracteres";
        if (!Regex.IsMatch(pw, @"[A-Z]")) yield return "Debe tener una letra mayúscula";
        if (!Regex.IsMatch(pw, @"[a-z]")) yield return "Debe tener una letra minúscula";
        if (!Regex.IsMatch(pw, @"[0-9]")) yield return "Debe tener un número";
    }

    private string PasswordMatch(string arg)
    {
        if (string.IsNullOrWhiteSpace(arg)) return "Por favor confirma tu contraseña";
        if (newPassword != arg) return "Las contraseñas no coinciden";
        return null;
    }

    private async Task HandleReset()
    {
        isLoading = true;
        StateHasChanged();

        await form.Validate();
        if (!form.IsValid)
        {
            Snackbar.Add("Credenciales incorrectas", Severity.Error);
            isLoading = false;
            StateHasChanged();
            return;
        }

        StateHasChanged();

        try
        {
            var success = await authService.ResetPasswordAsync(email, newPassword);
            if (success)
            {
                Snackbar.Add("¡Contraseña actualizada correctamente! Redirigiendo...", Severity.Success);
                await Task.Delay(2000);
                Navigation.NavigateTo("/login");
            }
            else
            {
                Snackbar.Add("Correo no encontrado en nuestro sistema", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al restablecer contraseña: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }
}