@using TiendaVirtual.Service
@inject UserContextService UserContext

@if (!_isLoading)
{
    <MudNavMenu>
        <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">
            Home
        </MudNavLink>

        <MudNavLink Href="productos" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Storage">
            Productos
        </MudNavLink>

        @if (_menuState.isAdmin)
        {
             <MudNavLink Href="/categorias" Icon="@Icons.Material.Filled.AddBox">
               Gestionar categorias
            </MudNavLink>
            <MudNavLink Href="/gestionar-producto" Icon="@Icons.Material.Filled.AddBox">
                Agregar Producto
            </MudNavLink>
            <MudNavLink Href="/admin/dashboard" Icon="@Icons.Material.Filled.StackedBarChart">
                Estadistica
            </MudNavLink>
        }

        @if (_menuState.isRepartidor)
        {
            <MudNavLink Href="/entregas" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.FireTruck">
                Entregas
            </MudNavLink>
        }

        @if (_menuState.isClient)
        {
            <MudNavLink Href="carrito" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ShoppingCart">
                Carrito
            </MudNavLink>
        }
    </MudNavMenu>
}

@code {
    private UserContextService.UserMenuState _menuState;
    private bool _isLoading = true;
    private Action _userStateChangedHandler;

    protected override async Task OnInitializedAsync()
    {
        // Solo una llamada asíncrona en lugar de tres
        _menuState = await UserContext.GetMenuStateAsync();
        _isLoading = false;

        _userStateChangedHandler = async () =>
        {
            _menuState = await UserContext.GetMenuStateAsync();
            await InvokeAsync(StateHasChanged);
        };

        UserContext.OnUserStateChanged += _userStateChangedHandler;
    }

    public void Dispose()
    {
        if (_userStateChangedHandler != null)
        {
            UserContext.OnUserStateChanged -= _userStateChangedHandler;
        }
    }
}